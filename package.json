{
  "name": "simplist.blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev-ns": "next dev --turbopack -p 3000",
    "dev": "next dev --turbopack -p 3000 --experimental-https",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:push": "pnpm --filter @simplist/db run db:push",
    "db:migrate": "pnpm --filter @simplist/db run db:migrate",
    "db:studio": "pnpm --filter @simplist/db run db:studio",
    "api:dev": "pnpm --filter @simplist/api run dev",
    "api:build": "pnpm --filter @simplist/db run build && pnpm --filter @simplist/api run build",
    "api:start": "pnpm --filter @simplist/api run start",
    "sdk:build": "pnpm --filter @simplist/sdk run build",
    "sdk:dev": "pnpm --filter @simplist/sdk run dev",
    "build:packages": "pnpm --filter @simplist/db run build && pnpm --filter @simplist/api run build && pnpm --filter @simplist/sdk run build",
    "vercel:build": "pnpm run build:packages && pnpm run build",
    "clean:r2": "node scripts/clean-r2-public.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.701.0",
    "@aws-sdk/client-ses": "^3.920.0",
    "@aws-sdk/s3-request-presigner": "^3.701.0",
    "@hookform/resolvers": "^5.2.2",
    "@number-flow/react": "^0.5.10",
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@react-email/render": "^1.4.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/mdx": "^2.0.13",
    "@simplist/db": "workspace:*",
    "better-auth": "^1.3.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fumadocs-core": "^16.0.1",
    "fumadocs-mdx": "^13.0.0",
    "fumadocs-ui": "^16.0.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.24",
    "next": "16.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.7.2",
    "prettier": "^3.6.2",
    "react": "19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "react-pay-icons": "^4.0.0",
    "react-qr-code": "^2.0.18",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "prisma": "^6.17.1",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4",
    "tailwindcss-intersect": "^2.2.0",
    "tailwindcss-motion": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
