{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "react"],
    "baseUrl": "./src",
    "paths": {
      "@/types": ["types/index"],
      "@/types/*": ["types/*"],
      "@/utils/*": ["utils/*"],
      "@/schemas/*": ["schemas/*"],
      "@/routes/*": ["routes/*"],
      "@/plugins/*": ["plugins/*"],
      "@/services/*": ["services/*"],
      "@/emails": ["emails/index"],
      "@/emails/*": ["emails/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
