// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Color {
  RED
  ORANGE
  AMBER
  YELLOW
  LIME
  GREEN
  EMERALD
  TEAL
  CYAN
  SKY
  BLUE
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
  BLACK
  WHITE
  GRAY
}

model User {
  id              String          @id
  name            String
  firstName       String?
  lastName        String?
  email           String
  emailVerified   Boolean         @default(false)
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  sessions        Session[]
  accounts        Account[]
  projects        Project[]
  projectMembers  ProjectMember[]
  articles        Article[]       @relation("ArticleAuthor")
  updatedArticles Article[]       @relation("ArticleLastUpdatedBy")

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]
  passkeys         Passkey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum SubscriptionTier {
  STARTER
  PRO
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Project {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String
  icon                  String              @default("building-2") // Icon name from Lucide icons
  color                 Color               @default(CYAN)
  avatarUrl             String? // Custom avatar/logo URL (stored in R2)
  allowedOrigins        String[]            @default([]) // Array of allowed origins for CORS
  timezone              String              @default("UTC") // Project timezone for scheduled publishing
  defaultLanguage       String              @default("en") // Default language for articles (ISO 639-1 code)
  baseUrl               String? // Base URL for the blog (e.g. "https://monblog.com")
  articleUrlPattern     String              @default("/blog/{slug}") // URL pattern for articles (e.g. "/blog/{slug}" or "/articles/{slug}")
  subscriptionTier      SubscriptionTier    @default(STARTER) // "STARTER" | "PRO" - Project-specific subscription tier
  subscriptionExpiresAt DateTime? // When the subscription expires (for pro projects)
  stripeCustomerId      String? // Stripe customer ID for this project
  stripeSubscriptionId  String? // Stripe subscription ID for this project
  monthlyApiCalls       Int                 @default(0) // Reset each month
  apiCallsResetAt       DateTime            @default(now()) // Date of last reset
  totalStorageUsed      Int                 @default(0) // In bytes
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags                  Tag[]
  apiKeys               ApiKey[]
  articles              Article[]
  members               ProjectMember[]
  roles                 ProjectRole[]
  invitations           ProjectInvitation[]
  webhooks              Webhook[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([slug])
  @@index([userId, createdAt])
  @@index([userId, subscriptionTier])
  @@map("project")
}

model Webhook {
  id           String    @id @default(cuid())
  name         String
  url          String
  events       String[]  @default([]) // e.g. ["article.published", "article.deleted"]
  secret       String?
  status       String    @default("active") // active, disabled
  lastSentAt   DateTime?
  failureCount Int       @default(0)
  headers      Json?

  // Custom payload configuration
  customPayload Json? // The complete JSON payload to send
  templateId    String? // "discord-message" | "discord-embed" | "slack-blocks" | "teams-card" | null

  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("webhook")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  status      String // success | failed
  response    Json?
  statusCode  Int?
  error       String?
  attemptedAt DateTime @default(now())

  @@index([webhookId, attemptedAt])
  @@map("webhook_delivery")
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color Color?
  icon  String? @default("tag")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tag")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String
  permissions String[]  @default([])
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  status      String    @default("active") // active, deleted
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key])
  @@index([projectId, status])
  @@index([key, status])
  @@map("api_key")
}

model Article {
  id                 String           @id @default(cuid())
  //
  title              String
  slug               String
  content            String
  excerpt            String?
  coverImage         String?
  published          Boolean          @default(false)
  status             String           @default("draft") // draft, published, deleted, scheduled
  viewCount          Int              @default(0)
  // Content statistics
  wordCount          Int              @default(0)
  characterCount     Int              @default(0)
  lineCount          Int              @default(0)
  readTimeMinutes    Int              @default(0)
  //
  tags               Tag[]
  // Scheduled publishing
  scheduledPublishAt DateTime?
  // Audit trail
  createdBy          String
  author             User             @relation("ArticleAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedBy          String?
  lastUpdatedBy      User?            @relation("ArticleLastUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  // Relations
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants           ArticleVariant[]
  pageViews          PageView[]
  pageEvents         PageEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  publishedAt        DateTime?
  deletedAt          DateTime?

  @@unique([slug, projectId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, published])
  @@map("article")
}

model ArticleVariant {
  id              String   @id @default(cuid())
  // Language
  lang            String // ISO 639-1 language code (e.g., "fr", "de", "es")
  // Content
  title           String
  excerpt         String?
  content         String
  coverImage      String? // PRO only: custom cover image per variant
  // Content statistics
  wordCount       Int      @default(0)
  characterCount  Int      @default(0)
  lineCount       Int      @default(0)
  readTimeMinutes Int      @default(0)
  // Relations
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([articleId, lang])
  @@index([articleId])
  @@map("article_variant")
}

model PageView {
  id             String   @id @default(cuid())
  // Relations
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  projectId      String
  // Visitor identification (anonymized)
  visitorId      String // Hash of IP + User Agent for anonymous tracking
  sessionId      String // Browser session ID
  // Geographic data
  ipAddress      String? // Hashed/anonymized IP
  country        String?
  countryCode    String?
  city           String?
  region         String?
  timezone       String?
  // Device/Browser info
  userAgent      String?
  device         String? // mobile, desktop, tablet
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  screenWidth    Int?
  screenHeight   Int?
  // Traffic source
  referrer       String?
  referrerDomain String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  // Engagement metrics
  timeOnPage     Int? // Time spent in seconds
  scrollDepth    Float? // Percentage scrolled (0-100)
  exitPosition   Float? // Where user was when leaving (0-100)
  bounced        Boolean  @default(false)
  // Request source tracking
  requestSource  String   @default("direct") // "direct" (web interface) or "sdk" (via SDK)
  // Metadata
  pageUrl        String?
  pageTitle      String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([articleId])
  @@index([projectId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([timestamp])
  @@index([country])
  @@index([projectId, timestamp])
  @@index([projectId, createdAt])
  @@index([articleId, timestamp])
  @@map("page_view")
}

model PageEvent {
  id         String   @id @default(cuid())
  // Relations
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  projectId  String
  // Visitor identification
  visitorId  String
  sessionId  String
  // Event data
  eventType  String // scroll_milestone, click, focus, blur, etc.
  eventData  Json? // Additional event-specific data
  position   Float? // Position in article (0-100)
  element    String? // CSS selector or element identifier
  // Timing
  timestamp  DateTime @default(now())
  timeOffset Int? // Milliseconds from page load

  @@index([articleId])
  @@index([projectId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("page_event")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

// Rôles personnalisables par projet
model ProjectRole {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String // "Administrator", "Editor", "Viewer", etc. (customizable)
  slug String // "admin", "editor", "viewer" (to identify the role)

  // Permissions granulaires
  canManageProject  Boolean @default(false) // Edit project settings
  canManageMembers  Boolean @default(false) // Invite/remove members
  canManageRoles    Boolean @default(false) // Edit roles/permissions
  canManageArticles Boolean @default(false) // Create/edit articles
  canManageApiKeys  Boolean @default(false) // Create/delete API keys
  canManageWebhooks Boolean @default(false) // Manage outgoing webhooks
  canViewAnalytics  Boolean @default(true) // View analytics
  canManageBilling  Boolean @default(false) // Manage billing (reserved for OWNER)
  canDeleteProject  Boolean @default(false) // Delete project (reserved for OWNER)

  isOwner   Boolean @default(false) // Ghost role reserved for creator
  isDefault Boolean @default(false) // Default role created at project initialization

  members ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, isDefault])
  @@map("project_role")
}

// User ↔ Project join table
model ProjectMember {
  id String @id @default(cuid())

  // Relations
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Assigned role (customizable)
  roleId String
  role   ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Tracking
  invitedBy String?
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([projectId, roleId])
  @@index([userId])
  @@map("project_member")
}

// Secure invitation system with token
model ProjectInvitation {
  id String @id @default(cuid())

  email     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  roleId String // Role to assign when accepting
  status InvitationStatus @default(PENDING)

  token     String   @unique
  expiresAt DateTime // 7 days by default

  invitedBy  String
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, projectId, status])
  @@index([token])
  @@index([projectId, status])
  @@map("project_invitation")
}
