// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  firstName     String?
  lastName      String?
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]
  passkeys         Passkey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum SubscriptionTier {
  STARTER
  PRO
}

model Project {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String
  description           String?
  icon                  String? // R2 object key for project icon
  allowedOrigins        String[]         @default([]) // Array of allowed origins for CORS
  timezone              String           @default("UTC") // Project timezone for scheduled publishing
  defaultLanguage       String           @default("en") // Default language for articles (ISO 639-1 code)
  subscriptionTier      SubscriptionTier @default(STARTER) // "STARTER" | "PRO" - Project-specific subscription tier
  subscriptionExpiresAt DateTime? // When the subscription expires (for pro projects)
  stripeCustomerId      String? // Stripe customer ID for this project
  stripeSubscriptionId  String? // Stripe subscription ID for this project
  // API usage tracking (moved from User)
  monthlyApiCalls       Int              @default(0) // Reset each month
  apiCallsResetAt       DateTime         @default(now()) // Date of last reset
  // Storage tracking (moved from User)
  totalStorageUsed      Int              @default(0) // In bytes
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys               ApiKey[]
  articles              Article[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([slug, userId])
  @@map("project")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String
  type        String    @default("secret") // secret (sk_), public (pk_)
  permissions String[]  @default(["read"]) // read, analytics
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  status      String    @default("active") // active, deleted
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key])
  @@map("api_key")
}

model Article {
  id                 String           @id @default(cuid())
  //
  title              String
  slug               String
  content            String
  excerpt            String?
  coverImage         String?
  published          Boolean          @default(false)
  status             String           @default("draft") // draft, published, deleted, scheduled
  viewCount          Int              @default(0)
  // Content statistics
  wordCount          Int              @default(0)
  characterCount     Int              @default(0)
  lineCount          Int              @default(0)
  readTimeMinutes    Int              @default(0)
  // Scheduled publishing
  scheduledPublishAt DateTime?
  // Relations
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants           ArticleVariant[]
  pageViews          PageView[]
  pageEvents         PageEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  publishedAt        DateTime?
  deletedAt          DateTime?

  @@unique([slug, projectId])
  @@map("article")
}

model ArticleVariant {
  id              String   @id @default(cuid())
  // Language
  lang            String // ISO 639-1 language code (e.g., "fr", "de", "es")
  // Content
  title           String
  excerpt         String?
  content         String
  coverImage      String? // PRO only: custom cover image per variant
  // Content statistics
  wordCount       Int      @default(0)
  characterCount  Int      @default(0)
  lineCount       Int      @default(0)
  readTimeMinutes Int      @default(0)
  // Relations
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([articleId, lang])
  @@index([articleId])
  @@map("article_variant")
}

model PageView {
  id             String   @id @default(cuid())
  // Relations
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  projectId      String
  // Visitor identification (anonymized)
  visitorId      String // Hash of IP + User Agent for anonymous tracking
  sessionId      String // Browser session ID
  // Geographic data
  ipAddress      String? // Hashed/anonymized IP
  country        String?
  countryCode    String?
  city           String?
  region         String?
  timezone       String?
  // Device/Browser info
  userAgent      String?
  device         String? // mobile, desktop, tablet
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  screenWidth    Int?
  screenHeight   Int?
  // Traffic source
  referrer       String?
  referrerDomain String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  // Engagement metrics
  timeOnPage     Int? // Time spent in seconds
  scrollDepth    Float? // Percentage scrolled (0-100)
  exitPosition   Float? // Where user was when leaving (0-100)
  bounced        Boolean  @default(false)
  // Metadata
  pageUrl        String?
  pageTitle      String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([articleId])
  @@index([projectId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([timestamp])
  @@index([country])
  @@map("page_view")
}

model PageEvent {
  id         String   @id @default(cuid())
  // Relations
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  projectId  String
  // Visitor identification
  visitorId  String
  sessionId  String
  // Event data
  eventType  String // scroll_milestone, click, focus, blur, etc.
  eventData  Json? // Additional event-specific data
  position   Float? // Position in article (0-100)
  element    String? // CSS selector or element identifier
  // Timing
  timestamp  DateTime @default(now())
  timeOffset Int? // Milliseconds from page load

  @@index([articleId])
  @@index([projectId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("page_event")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}
