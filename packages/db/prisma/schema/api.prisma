// ============================================
// API MODELS
// ApiKey, Webhook, WebhookDelivery
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String
  permissions String[]  @default([])
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  status      String    @default("active") // active, deleted
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key])
  @@index([projectId, status])
  @@index([key, status])
  @@map("api_key")
}

model Webhook {
  id           String    @id @default(cuid())
  name         String
  url          String
  events       String[]  @default([]) // e.g. ["article.published", "article.deleted"]
  secret       String?
  status       String    @default("active") // active, disabled
  lastSentAt   DateTime?
  failureCount Int       @default(0)
  headers      Json?

  // Custom payload configuration
  customPayload Json? // The complete JSON payload to send
  templateId    String? // "discord-message" | "discord-embed" | "slack-blocks" | "teams-card" | null

  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("webhook")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  status      String // success | failed
  response    Json?
  statusCode  Int?
  error       String?
  attemptedAt DateTime @default(now())

  @@index([webhookId, attemptedAt])
  @@map("webhook_delivery")
}
